{
  // Default: mengarah ke mock lokal (dotnet run -- mock).
  // Untuk tenant asli: ganti GatewayUrl dan TokenUrl, lalu isi AppKey/AppSecret
  // lewat environment variable YS_APPKEY / YS_APPSECRET (jangan ditulis di file ini),
  // atau tempel access token dari Postman ke env YS_TOKEN.
  "GatewayUrl": "http://localhost:5055",
  "TokenUrl": "http://localhost:5055/open-auth/selfAppAuth/getAccessToken",
  "AppKey": "mock-key",
  "AppSecret": "mock-secret",
  "StaticAccessToken": "",

  "ImportPath": "/yonbip/sd/dst/tradevouch/import",
  "QueryPath": "/yonbip/sd/dst/tradevouch/query",
  // {shopcode} dan {tid} diganti otomatis. Samakan dengan body query di Postman.
  "QueryBodyTemplate": "{\"pageIndex\":1,\"pageSize\":10,\"partParam\":{\"shopcode\":\"{shopcode}\",\"tid\":\"{tid}\"}}",

  // Nama properti array order di file input dan di body import.
  "OrdersArrayProperty": "data",
  "TidField": "tid",
  "ShopcodeField": "shopcode",
  "OrgCodeField": "orgCode",
  "SuccessMessage": "导入失败0单",

  "AllowedShopcodes": [ "E0001", "E0002", "E0003", "E0004", "E0005", "E0006", "E0007", "112026", "S0001" ],

  "TimeoutSeconds": 15,
  "DelayMsBetweenCalls": 300,

  "LedgerPath": "data/ledger.json",
  "LogDir": "data/logs",
  "DryRunDir": "data/dryrun",
  "CorrectionsPath": "corrections.csv"
}
