{
  // Default: mengarah ke mock lokal (dotnet run -- mock).
  // Untuk tenant asli: ganti GatewayUrl dan TokenUrl, lalu isi AppKey/AppSecret
  // lewat environment variable YS_APPKEY / YS_APPSECRET (jangan ditulis di file ini),
  // atau tempel access token dari Postman ke env YS_TOKEN.
  "GatewayUrl": "http://localhost:5055",
  "TokenUrl": "http://localhost:5055/open-auth/selfAppAuth/getAccessToken",
  "AppKey": "mock-key",
  "AppSecret": "mock-secret",
  "StaticAccessToken": "",

  "ImportPath": "/yonbip/sd/dst/tradevouch/import",
  "QueryPath": "/yonbip/sd/dst/tradevouch/query",
  // {shopcode} dan {tid} diganti otomatis. Terbukti di tenant NAC 21 Nov 2026:
  // pageIndex/pageSize WAJIB di dalam partParam (di luar -> error 999 "nomor halaman tidak dikirim").
  "QueryBodyTemplate": "{\"partParam\":{\"pageIndex\":1,\"pageSize\":10,\"shopcode\":\"{shopcode}\",\"tid\":\"{tid}\"}}",

  // Struktur payload tradevouch/import: {"externalData":[order...], "partParam":{"orgCode":"..."}}
  "OrdersArrayProperty": "externalData",
  "RootOrgCodePath": "partParam.orgCode",
  "TidField": "tid",
  "ShopcodeField": "shopcode",
  "OrgCodeField": "orgCode",
  "SuccessMessage": "导入失败0单",

  // 112026 (JUBELIO) sengaja tidak ada: toko itu untuk tes eksternal YY.
  "AllowedShopcodes": [ "E0001", "E0002", "E0003", "E0004", "E0005", "E0006", "E0007", "E0008", "S0001" ],

  // ---------------- Transformer: raw JSON Ecolink -> payload YonSuite
  "OrgCode": "ecolink",
  // "zero" = sub_order_tax_fee 0, sama seperti payload batch B/C yang sukses (PPN dihitung YonSuite dari material).
  // "inclusive11" = payment x 11/111.
  "TaxMode": "zero",
  "PhonePlaceholder": "081234567890",
  "NermanKeyword": "NERMAN",

  // Source = nilai "source" Jubelio yang diharapkan. Kosong = belum diketahui, tidak dicek.
  // Order TikTok Shop membawa source "Shop | Tokopedia" (terbukti di toko 93837, 21 Nov).
  // E0005 dan E0007 belum ada order COMPLETED di Ecolink, jadi source-nya belum dicek.
  // E0008 (LAZADA - Nerman) belum bisa ditambahkan: store_id Jubelio-nya belum diketahui.
  "StoreMap": [
    { "StoreId": 93744,  "Shopcode": "E0001", "Source": "SHOPEE",    "Brand": "Purbasari" },
    { "StoreId": 116792, "Shopcode": "E0002", "Source": "SHOPEE",    "Brand": "Nerman" },
    { "StoreId": 93840,  "Shopcode": "E0003", "Source": "TOKOPEDIA", "Brand": "Purbasari" },
    { "StoreId": 93836,  "Shopcode": "E0004", "Source": "LAZADA",    "Brand": "Purbasari" },
    { "StoreId": 117917, "Shopcode": "E0005", "Source": "",          "Brand": "Nerman" },
    { "StoreId": 93837,  "Shopcode": "E0006", "Source": "Shop | Tokopedia", "Brand": "Purbasari" },
    { "StoreId": 121983, "Shopcode": "E0007", "Source": "",          "Brand": "Nerman" }
  ],

  // Lokasi Jubelio (loc_name / location_name) -> gudang YonSuite.
  // Fase pengujian: SEMUA lokasi ke WH001. Gudang FAS di YonSuite dibuat setelah pengujian berhasil,
  // lalu baris di bawah tinggal diganti ke kode gudang masing-masing.
  "WarehouseMap": {
    "Pusat": "WH001",
    "FAS - Makassar": "WH001",
    "FAS - Medan": "WH001",
    "FAS - Semarang": "WH001",
    "FAS - Sidoarjo": "WH001"
  },

  "TimeoutSeconds": 15,
  "DelayMsBetweenCalls": 300,

  "LedgerPath": "data/ledger.json",
  "LogDir": "data/logs",
  "DryRunDir": "data/dryrun",
  "CorrectionsPath": "corrections.csv"
}
